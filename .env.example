# Local PostgreSQL connection. Create the database before running migrations.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/inventory_erp

# Use a long random value; never commit the real .env file.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Keep false for local HTTP. Set true when serving over HTTPS.
COOKIE_SECURE=false
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# SSLCommerz hosted checkout. Use sandbox first; move to live after approval.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_MODE=sandbox

# SSLCommerz callback endpoints must be publicly reachable; production uses HTTPS.
FRONTEND_BASE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
DELIVERY_FEE_BDT=0.00
# Minutes before an unpaid online-payment order is cancelled and its stock released.
PAYMENT_WINDOW_MINUTES=30

# Optional SMTP invoice email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
